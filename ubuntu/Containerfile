FROM scratch AS ctx

COPY ../shared/ /shared

FROM  docker.io/library/ubuntu:questing AS base

FROM base AS builder

# apt can briefly hit an inconsistent index on rolling releases; retry the
# install against a fresh package list before failing.
RUN --mount=type=tmpfs,dst=/tmp --mount=type=tmpfs,dst=/root --mount=type=tmpfs,dst=/boot /bin/bash -c '
    set -euo pipefail
    PKGS="git curl make build-essential go-md2man libzstd-dev pkgconf libostree-dev ostree clang libclang-dev"
    rm -f /var/lib/apt/lists/*
    apt-get update -y
    status=1
    for i in 1 2 3; do
      set -f
      apt-get install -y --fix-missing $PKGS && { status=0; set +f; break; } || { status=$?; set +f; sleep 15; apt-get update -y; }
    done
    [ "$status" -eq 0 ] || exit "$status"
'

ENV CARGO_HOME=/tmp/rust
ENV RUSTUP_HOME=/tmp/rust
WORKDIR /home/build
RUN --mount=type=bind,from=ctx,source=/,target=/ctx \
    curl --proto '=https' --tlsv1.2 -sSf "https://sh.rustup.rs" | sh -s -- --profile minimal -y && \
    sh -c ". ${RUSTUP_HOME}/env ; /ctx/shared/build.sh"

FROM base AS system
COPY --from=builder /output /

# apt can briefly hit an inconsistent index; retry against a fresh list.
RUN --mount=type=tmpfs,dst=/tmp --mount=type=tmpfs,dst=/root --mount=type=tmpfs,dst=/boot /bin/bash -c '
    set -euo pipefail
    PKGS="btrfs-progs bubblewrap dosfstools e2fsprogs fdisk linux-firmware linux-image-generic netplan.io openssh-server systemd-resolved chrony skopeo systemd systemd-boot* xfsprogs libostree-dev dracut build-essential procps curl file git sudo"
    rm -f /var/lib/apt/lists/*
    apt-get update -y
    status=1
    for i in 1 2 3; do
      set -f
      apt-get install -y --fix-missing $PKGS && { status=0; set +f; break; } || { status=$?; set +f; sleep 15; apt-get update -y; }
    done
    [ "$status" -eq 0 ] || exit "$status"
    cp /boot/vmlinuz-* "$(find /usr/lib/modules -maxdepth 1 -type d | tail -n 1)/vmlinuz"
    apt-get clean -y
'

RUN systemctl enable systemd-networkd systemd-resolved ssh && \
    printf 'L! /etc/resolv.conf - - - - /run/systemd/resolve/stub-resolv.conf\n' \
        > /usr/lib/tmpfiles.d/resolv-conf.conf && \
    mkdir -p /etc/netplan && \
    printf 'network:\n  version: 2\n  ethernets:\n    all-en:\n      match:\n        name: en*\n      dhcp4: true\n    all-eth:\n      match:\n        name: eth*\n      dhcp4: true\n' > /etc/netplan/90-default.yaml

RUN --mount=type=tmpfs,dst=/tmp --mount=type=tmpfs,dst=/root \
    --mount=type=bind,from=ctx,source=/,target=/ctx \
    /ctx/shared/initramfs.sh

RUN --mount=type=bind,from=ctx,source=/,target=/ctx \
    echo "HOME=/var/home" | tee -a "/etc/default/useradd" && \
    /ctx/shared/bootc-rootfs.sh

# Daily-driver tooling: Homebrew (persists on /var) + curated CLI addons.
RUN --mount=type=bind,from=ctx,source=/,target=/ctx \
    /ctx/shared/linuxbrew.sh

LABEL containers.bootc 1

RUN bootc container lint
